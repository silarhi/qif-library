{
  "name": "silarhi/qif-library",
  "description": "A PHP library to parse and write QIF (Quicken Interchange Format) files",
  "type": "library",
  "keywords": [
    "qif",
    "writer",
    "parser"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "SILARHI",
      "email": "hello@silarhi.fr"
    }
  ],
  "autoload": {
    "psr-4": {
      "Silarhi\\Qif\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Silarhi\\Qif\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.90",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.2"
  }
}
