{
    "name": "silarhi/qif-library",
    "description": "A PHP library to parse and write QIF (Quicken Interchange Format) files",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "qif",
        "quicken",
        "parser",
        "writer",
        "qif-parser",
        "finance",
        "bank"
    ],
    "authors": [
        {
            "name": "SILARHI",
            "email": "hello@silarhi.fr"
        }
    ],
    "homepage": "https://qif-library.silarhi.dev",
    "support": {
        "issues": "https://github.com/silarhi/qif-library/issues",
        "source": "https://github.com/silarhi/qif-library",
        "docs": "https://qif-library.silarhi.dev"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54.0",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.4",
        "phpstan/phpstan-strict-rules": "^2.1.0",
        "phpunit/phpunit": "^11.5.57 || ^12.5.38 || ^13.4.1",
        "rector/rector": "^2.8.3"
    },
    "autoload": {
        "psr-4": {
            "Silarhi\\Qif\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Silarhi\\Qif\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "block-insecure": false
        },
        "bump-after-update": "dev",
        "sort-packages": true
    }
}
