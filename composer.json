{
  "name": "mimographix/qif-library",
  "description": "A simple QIF parsing/writing library.",
  "version": "1.0.0",
  "type": "library",
  "keywords": [
    "qif",
    "writer",
    "parser"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "MimoGraphix",
      "email": "mimographix@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "MimoGraphix\\QIF\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MimoGraphix\\QIF\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.90",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.2"
  }
}
